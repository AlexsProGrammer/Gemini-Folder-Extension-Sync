{
  "name": "gemini-project-extension",
  "private": true,
  "version": "2.0.6",
  "type": "module",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:chrome": "node ./scripts/build.mjs --target=chrome",
    "build:firefox": "node ./scripts/build.mjs --target=firefox",
    "build:all": "node ./scripts/build.mjs",
    "dev": "vite build --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "package:store": "node ./scripts/package-store.mjs",
    "package:firefox": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-firefox.ps1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.262",
    "@types/webextension-polyfill": "^0.12.6",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.6.7"
  }
}
