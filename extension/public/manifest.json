{
    "manifest_version": 3,
    "name": "Synced Projects for Gemini",
    "version": "2.1.1",
    "description": "Projects, folders & a prompt library for Gemini with optional self-hosted encrypted sync to your own server.",
    "permissions": [
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "https://gemini.google.com/*"
    ],
    "optional_host_permissions": [
        "https://*/*",
        "http://*/*"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "gemini-folder-sync@pro-grammer.de",
            "strict_min_version": "128.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "background": {
        "service_worker": "background.js",
        "scripts": [
            "background.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "https://gemini.google.com/*"
            ],
            "js": [
                "pageBridge.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://gemini.google.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "pageBridge.js",
                "icons/*"
            ],
            "matches": [
                "https://gemini.google.com/*"
            ]
        }
    ],
    "action": {
        "default_title": "Synced Projects for Gemini",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    }
}
