{
    "manifest_version": 3,
    "name": "Projects for Gemini™: Projects and Prompt Manager",
    "version": "2.0.6",
    "description": "Group Gemini chats into local Projects.",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://gemini.google.com/*"
    ],
    "optional_host_permissions": [
        "https://*/*",
        "http://*/*"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "gemini-workspace-sync@local.dev",
            "strict_min_version": "121.0"
        }
    },
    "background": {
        "service_worker": "background.js",
        "scripts": [
            "background.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "https://gemini.google.com/*"
            ],
            "js": [
                "pageBridge.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://gemini.google.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_title": "Projects for Gemini™: Projects and Prompt Manager",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    }
}
