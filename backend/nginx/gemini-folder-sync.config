# =============================================================================
# Gemini Folder Sync — nginx reverse proxy (TLS + edge API-key gate)
# =============================================================================
# This file is included inside nginx's `http {}` context (it uses `map`,
# `limit_req_zone` and `upstream`, which are only valid there).
#
# Install (Debian/Ubuntu):
#   sudo cp nginx/gemini-folder-sync.config \
#           /etc/nginx/sites-available/gemini-folder-sync.conf
#   sudo ln -s /etc/nginx/sites-available/gemini-folder-sync.conf \
#              /etc/nginx/sites-enabled/
#   # Or, for conf.d-style setups, copy it in as gemini-folder-sync.conf —
#   # nginx only auto-includes *.conf there, the .config suffix is NOT picked up.
#   sudo nginx -t && sudo systemctl reload nginx
#
# Before enabling:
#   1. Replace every `sync.example.com` with your DNS name.
#   2. Put the exact same API key as backend/.env into the `map` below.
#      The installed file then contains a secret: `sudo chmod 600 <path>`.
#   3. Obtain a certificate, e.g.:
#        sudo mkdir -p /var/www/certbot
#        sudo certbot certonly --webroot -w /var/www/certbot -d sync.example.com
#   4. Start the backend via docker compose; it must remain bound to
#      127.0.0.1:3000 (the default in docker-compose.yml) so it is only
#      reachable through nginx.
#
# What this does:
#   - HTTP -> HTTPS redirect (ACME webroot stays on plain HTTP for renewals).
#   - TLS 1.2/1.3 only, Mozilla "intermediate"-grade settings, HSTS.
#   - Rejects requests whose Authorization header is missing or does not
#     match the backend API key with 401 at the edge (defense in depth;
#     the backend re-validates in constant time anyway).
#   - Only exposes GET|POST /api/v1/sync/<64 lowercase hex chars>;
#     everything else is a hard 404. If the backend gains new routes,
#     add them here too.
#   - Per-IP rate limiting, body limit (app limit is 10 MB), sane timeouts.
#   - Access log without client IPs or query strings (matches the backend's
#     log-hygiene policy); nginx never logs the Authorization header.
# =============================================================================

# --- Edge API-key check -------------------------------------------------------
# Exact match on "Bearer <API_KEY>". Must be byte-identical to API_KEY in
# backend/.env (the "Bearer " prefix is part of the value). If the key
# contains `"` or `\`, escape them as `\"` and `\\`.
# A missing or wrong key is rejected here with 401 and never reaches the app;
# a forgotten placeholder therefore fails closed (all requests 401).
map $http_authorization $gemini_sync_key_ok {
    default                                        0;
    "Bearer REPLACE_WITH_SAME_KEY_AS_BACKEND_ENV"  1;
}

# Alternative (avoid duplicating the secret in nginx): only require that a
# Bearer token is present and let the backend validate it.
# map $http_authorization $gemini_sync_key_ok {
#     default        0;
#     "~^Bearer .+"  1;
# }

# --- Limits -------------------------------------------------------------------
# Per-client-IP rate limit: sync traffic is tiny, so 30 req/min with a burst
# of 10 is generous. If you sit behind a CDN (e.g. Cloudflare), rate-limit on
# the real client IP header instead of $binary_remote_addr.
limit_req_zone $binary_remote_addr zone=gemini_sync_rl:10m rate=30r/m;

# Privacy-friendly log format: no client IPs, no query strings.
log_format gemini_sync_privacy '$time_iso8601 "$request_method" "$uri" '
                               'status=$status bytes=$body_bytes_sent '
                               'rt=$request_time "$http_user_agent"';

upstream gemini_sync_backend {
    server 127.0.0.1:3000;   # backend must stay loopback-bound
    keepalive 16;
}

# --- HTTP -> HTTPS ------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name sync.example.com;                      # <-- change me

    # Keep ACME challenges on plain HTTP so certbot renewals keep working.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS --------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    # nginx >= 1.25.1; on older versions use `listen 443 ssl http2;` instead.
    http2 on;

    server_name sync.example.com;                      # <-- change me

    ssl_certificate     /etc/letsencrypt/live/sync.example.com/fullchain.pem;  # <-- change me
    ssl_certificate_key /etc/letsencrypt/live/sync.example.com/privkey.pem;    # <-- change me

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_timeout 1d;
    ssl_session_cache shared:gemini_sync_ssl:10m;
    ssl_session_tickets off;

    server_tokens off;

    # Security headers. Enable HSTS only after HTTPS is confirmed working —
    # it pins browsers to HTTPS for this domain for two years.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cache-Control "no-store" always;

    access_log /var/log/nginx/gemini-sync.access.log gemini_sync_privacy;
    error_log  /var/log/nginx/gemini-sync.error.log warn;

    keepalive_timeout   30s;
    client_body_timeout 15s;
    send_timeout        30s;

    # Exact API surface: GET|POST /api/v1/sync/<64 lowercase hex chars>.
    location / {
        return 404;
    }

    location ~ ^/api/v1/sync/[0-9a-f]{64}$ {
        # Only the methods the API defines (HEAD rides along on GET).
        if ($request_method !~ ^(GET|HEAD|POST)$) { return 405; }

        # Edge API-key gate (see the map above).
        if ($gemini_sync_key_ok = 0) { return 401; }

        limit_req zone=gemini_sync_rl burst=10 nodelay;
        limit_req_status 429;

        # App body limit is 10 MB (see src/main.ts); leave headroom.
        client_max_body_size 11m;

        proxy_pass http://gemini_sync_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
    }
}

# --- Optional hardening (dedicated single-site box) ---------------------------
# Drop host-header/IP probing by rejecting any Host other than yours.
# Commented out because it collides with other default_server blocks.
# server {
#     listen 80 default_server;
#     listen [::]:80 default_server;
#     server_name _;
#     return 444;                       # close connection without a response
# }
# server {
#     listen 443 ssl default_server;
#     listen [::]:443 ssl default_server;
#     server_name _;
#     ssl_reject_handshake on;          # nginx >= 1.19.4
# }
